<!--            </intent-filter>-->
        </activity>

        <meta-data
            android:name="android.telephony.PROPERTY_SATELLITE_DATA_OPTIMIZED"
            android:value="com.rtbishop.look4sat.bg7nta" />

            <service
            android:name="com.rtbishop.look4sat.app.AprsForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
